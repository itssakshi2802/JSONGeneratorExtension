{
  "manifest_version": 3,
  "name": "Student Focus Timer",
  "version": "1.0",
  "description": "A Pomodoro-style timer to help students stay focused.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "permissions": ["notifications"],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "popup.js"
  }
}
